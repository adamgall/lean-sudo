# Aliases
User_Alias	ADMINS = alice, bob, %wheel : OPS = carol
Runas_Alias	OP = root, operator
Host_Alias	SERVERS = web1, db*.example.com, !db9.example.com
Cmnd_Alias	SHELLS = /bin/sh, /bin/bash, \
		/usr/bin/zsh
Cmd_Alias	PRINT = /usr/bin/lp ""

Defaults	env_keep += "A B", !lecture
Defaults:alice	!authenticate
Defaults>root	!set_logname
Defaults!/bin/ls	use_pty
Defaults@SERVERS	log_output, passprompt="Pw \"x\": "

# inheritance
alice	ALL = (root) NOPASSWD: /bin/ls, /bin/cat, PASSWD: /bin/sh
ADMINS	SERVERS = (OP : wheel) SETENV: ALL, !SHELLS : db1 = (:adm) CWD=/tmp /usr/bin/vi /etc/hosts
%#27,#1000	ALL = ALL, !/usr/bin/su, !!/usr/bin/id
dave ALL = sudoedit /etc/motd, /usr/bin/printf a\,b\:c   d # trailing comment
