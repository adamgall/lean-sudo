# syntax=docker/dockerfile:1






ARG BASE=ubuntu:26.04
FROM ${BASE} AS build

ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8 PATH=/root/.elan/bin:$PATH
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl git build-essential zstd python3 \
 && rm -rf /var/lib/apt/lists/*


COPY lean-toolchain /src/lean-toolchain
RUN curl -sSf https://raw.githubusercontent.com/leanprover/elan/master/elan-init.sh \
      | sh -s -- -y --default-toolchain none \
 && cd /src && elan toolchain install "$(cat lean-toolchain)" && lean --version

COPY . /src
WORKDIR /src

RUN --mount=type=cache,id=lean-sudo-lake,sharing=locked,target=/src/.lake \
    lake build sudo visudo \
 && scripts/check-ffi.sh \
 && scripts/check-c-boundary.sh \
 && mkdir -p /out && cp .lake/build/bin/sudo .lake/build/bin/visudo /out/


FROM scratch AS artifact
COPY --from=build /out/ /
