#!/usr/bin/env python3
import os
import pathlib
import sys
import uuid

arguments = sys.argv[1:]
case = os.environ.get("SUDO_EXTERNAL_CASE_DIR")
if case and arguments and arguments[0] == "run":
    cidfile = pathlib.Path(case) / f"{uuid.uuid4().hex}.cid"
    arguments[1:1] = ["--cidfile", str(cidfile)]
os.execv("/usr/bin/docker", ["docker", *arguments])
